DISCORD_TOKEN=replace-with-a-new-token-after-reset

# Recommended: set IDs so channel names do not need to match exactly.
# Enable Developer Mode in Discord, then right-click a channel/server and Copy ID.
GUILD_ID=
TEXT_CHANNEL_ID=
VOICE_CHANNEL_ID=

# Channel names are used when the corresponding ID above is left blank.
TEXT_CHANNEL_NAME=music-requests
VOICE_CHANNEL_NAME=Music
